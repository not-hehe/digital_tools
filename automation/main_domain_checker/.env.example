# Скопируйте в .env рядом с run.sh - обёртка подхватит файл сама.
# .env закрыт .gitignore и в репозиторий не попадает.

# Incoming Webhook Mattermost. Пусто - сообщения не отправляются,
# прогон при этом продолжается и печатает отчёт в stdout.
DC_MATTERMOST_WEBHOOK=

# Ссылка на Google-таблицу со списком (доступ "все, у кого есть ссылка" на просмотр):
# один лист, колонки "ошибки", "внутренний", "внешний". Ссылка - секрет, как и вебхук.
# Ниже пример, замените его на ссылку своей таблицы из адресной строки браузера.
# Пусто или чужая ссылка - прогон останавливается с кодом 3 и одним сообщением в канал.
DC_SHEET_URL=https://docs.google.com/spreadsheets/d/EXAMPLE_ID/edit#gid=0

# Какой контур проверять: 1 - внешний, 2 - внутренний. Колонка "ошибки"
# проверяется всегда, но о её сайтах сообщается только когда они оживают.
DC_CONTOUR=1

# Где помнить состояние доменов между запусками. Пусто = data/state.json.
# Задавайте полным путём, если каталог со скриптом переустанавливается:
# DC_STATE_FILE=/var/lib/domain-checker/state.json
DC_STATE_FILE=

# Текстовый лог прогонов и событий. Пусто = data/runs.log.
DC_RUNLOG_FILE=

# Использовать прокси из переменных окружения. Пусто = не использовать.
# На хосте, где выход в интернет идёт только через прокси, без этого все
# публичные домены дадут ложные отказы.
DC_TRUST_ENV=

DC_LOG_LEVEL=INFO
