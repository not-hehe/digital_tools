# Incoming Webhook Mattermost. Пусто - сообщения не отправляются.
DC_MATTERMOST_WEBHOOK=

# Откуда берётся список доменов. Сейчас доступен только file (Excel в data/).
DC_TARGET_SOURCE=file

# Использовать прокси из переменных окружения. Пусто = не использовать.
# На сервере с прокси-выходом в интернет без этого все публичные домены
# дадут ложные отказы.
DC_TRUST_ENV=

DC_LOG_LEVEL=INFO
